# Every variable novaops-final reads. Values stay empty here.
# Put the real .env at the Daedalus workspace root (or the repo root). The code loads it with
# load_dotenv(find_dotenv()), which walks up from the working directory.
# Never copy a lesson-code .env into this repo.

# Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Region of both Bedrock and the OpenSearch collection.
AWS_REGION=
# Nova 2 Lite cross-region inference profile id (the "us." one).
BEDROCK_MODEL_ID=
# Titan Text Embeddings V2, 1024 dimensions.
BEDROCK_EMBEDDING_MODEL_ID=

# OpenSearch Serverless
# Collection name: novaops-rag. The endpoint is resolved from it.
OPENSEARCH_COLLECTION=
# Index name: novaops-final-kb. Never novaops-kb or any other lesson index.
OPENSEARCH_INDEX=
# Optional. Pins the endpoint and skips the lookup.
OPENSEARCH_ENDPOINT=
# Optional. Only when OpenSearch lives in a different AWS account from Bedrock. Set both or neither.
OPENSEARCH_AWS_ACCESS_KEY_ID=
OPENSEARCH_AWS_SECRET_ACCESS_KEY=

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Optional. false switches tracing off (development and ablation runs). Graded and
# baseline runs are traced; the eval scripts set it from their --trace flag.
LANGFUSE_TRACING_ENABLED=

# MCP server. Default http://127.0.0.1:9880/mcp
MCP_SERVER_URL=

# NovaOps runtime
# Absolute path to the read-only course repo (holds the dataset and GOLDEN-DATASETS.json).
NOVAOPS_COURSE_DIR=
# SQLite file for the NovaOps business data. Restored by `python -m scripts.reseed`.
NOVAOPS_DB_PATH=
# SQLite file for LangGraph checkpoints (AsyncSqliteSaver).
NOVAOPS_CHECKPOINT_DB=
# Pinned clock: 2026-07-01.
NOVAOPS_TODAY=
# Optional. Comma list of heuristics to switch off for an ablation run (agent/heuristics.py).
NOVAOPS_HEURISTICS_OFF=

# Judges (Langfuse-managed evaluators, evals/register_judges.py)
# Amazon Nova Pro inference profile: us.amazon.nova-pro-v1:0 (us-east-1).
JUDGE_MODEL_ID=
